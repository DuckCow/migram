# GitHub Credentials
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token

# Database Configuration
DATABASE_URL=jdbc:mysql://your-db-host:3306/migram?createDatabaseIfNotExist=true
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# AWS S3 Configuration
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Test AWS Credentials (optional)
TEST_ACCESS_KEY=your_test_access_key
TEST_SECRET_KEY=your_test_secret_key

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DEV_GOOGLE_CLIENT_ID=your_dev_google_client_id
DEV_GOOGLE_CLIENT_SECRET=your_dev_google_client_secret

# JWT Secret Key (IMPORTANT: Change this in production!)
# Generate a strong random key with at least 256 bits (32+ characters)
# You can use: openssl rand -base64 32
JWT_SECRET_KEY=change-this-to-a-strong-random-key-minimum-32-characters-or-more-for-security

# Spring Profile (dev, prod, test)
SPRING_PROFILE=dev
